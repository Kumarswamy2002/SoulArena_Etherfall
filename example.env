# Soul Arena: Etherfall - Example Environment Configuration
PROJECT_NAME="Soul Arena: Etherfall API"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security Secrets (Override in production!)
SECRET_KEY=change_this_to_a_super_secret_cryptographic_key_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL=postgresql+asyncpg://soularena:soularenapass@localhost:5432/soularenadb

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Matchmaking & Balancing Parameters
MATCHMAKING_MMR_TOLERANCE=150
MATCHMAKING_EXPANSION_RATE_PER_SEC=10
MAX_QUEUE_WAIT_SECONDS=60
